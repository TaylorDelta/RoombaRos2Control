  "userNodes": {
    "43c09049-098d-4d20-bb7a-f97be4d05cd2": {
      "sourceCode": "// ==UserScript==\n// @name         FoxyGlove Simple Value Display\n// @namespace    http://tampermonkey.net/\n// @version      1.0\n// @description  Display /dynamic_joint_states.interface_values[1].values[13] in FoxyGlove\n// @author       YourName\n// @match        *://*/*\n// @grant        none\n// ==/UserScript==\n\n(function() {\n    'use strict';\n\n    // Make sure FoxyGlove is loaded\n    function waitForFoxyGlove(callback) {\n        if (window.FoxyGlove) {\n            callback();\n        } else {\n            setTimeout(() => waitForFoxyGlove(callback), 100);\n        }\n    }\n\n    waitForFoxyGlove(() => {\n        // Create a container for the value\n        const container = document.createElement('div');\n        container.style.position = 'fixed';\n        container.style.bottom = '20px';\n        container.style.right = '20px';\n        container.style.padding = '10px';\n        container.style.backgroundColor = 'rgba(0,0,0,0.7)';\n        container.style.color = 'white';\n        container.style.fontSize = '18px';\n        container.style.borderRadius = '5px';\n        container.innerText = 'Value: --';\n        document.body.appendChild(container);\n\n        // Subscribe to the topic\n        const ros = window.FoxyGlove.ros; // assume ROS connection is exposed\n\n        const listener = new window.FoxyGlove.Topic({\n            ros: ros,\n            name: '/dynamic_joint_states',\n            messageType: 'your_msgs/DynamicJointStates', // replace with actual type\n        });\n\n        listener.subscribe((msg) => {\n            try {\n                // Safely extract the value\n                const value = msg.interface_values?.[1]?.values?.[13];\n                container.innerText = 'Value: ' + (value !== undefined ? value.toFixed(4) : '--');\n            } catch (err) {\n                container.innerText = 'Value: --';\n                console.error('Error reading value:', err);\n            }\n        });\n    });\n})();",
      "name": "43c09049"
    }
  }
