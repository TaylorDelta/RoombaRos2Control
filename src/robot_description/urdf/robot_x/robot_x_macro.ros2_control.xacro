<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="robot_x_ros2_control" params="
               name
               prefix
               use_mock_hardware:=false
               mock_sensor_commands:=false
               sim_gazebo_classic:=false
               sim_gazebo:=false
               simulation_controllers
               wheelbase"
               >

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
        </xacro:if>
        <xacro:if value="${sim_gazebo_classic}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware or sim_gazebo_classic or sim_gazebo}">
          <plugin>robot_hardware_interface/RobotHardwareInterface</plugin>
        </xacro:unless>
        <param name="wheelbase">${wheelbase}</param>
      </hardware>

      <!-- Joint definitions -->
      <joint name="${prefix}left_wheel_joint">
        <command_interface name="velocity">     
          <param name="min">-301</param>
          <param name="max">301</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>

      <joint name="${prefix}right_wheel_joint">
        <command_interface name="velocity">   
          <param name="min">-301</param> 
          <param name="max">301</param> 
        </command_interface>
        <state_interface name="position"/>
      </joint>

      <joint name="${prefix}clean_mode_joint">
        <command_interface name="velocity">
          <param name="min">0</param>
          <param name="max">7</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>

      <joint name="${prefix}linear_velocity_joint">
        <command_interface name="velocity">
          <param name="min">-0.5</param>
          <param name="max">0.5</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>  

      <joint name="${prefix}angular_velocity_joint">
        <command_interface name="velocity">
          <param name="min">-1.0</param>
          <param name="max">1.0</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>
      <!-- Joint definitions end -->

      <!-- Sensor definitions -->
      <sensor name="${prefix}sensor_data">
        <state_interface name="bumps_right"/>
        <state_interface name="bumps_left"/>
        <state_interface name="wheeldrops_right"/>
        <state_interface name="wheeldrops_left"/>
        <state_interface name="wheeldrops_caster"/>
        <state_interface name="wall"/>
        <state_interface name="cliff_left"/>
        <state_interface name="cliff_front_left"/>
        <state_interface name="cliff_front_right"/>
        <state_interface name="cliff_right"/>
        <state_interface name="virtual_wall"/>
        <state_interface name="motor_overcurrents_sidebrush"/>
        <state_interface name="motor_overcurrents_vacuum"/>
        <state_interface name="motor_overcurrents_mainbrush"/>
        <state_interface name="motor_overcurrents_driveright"/> 
        <state_interface name="motor_overcurrents_driveleft"/>
        <state_interface name="dirt_detector_left"/>
        <state_interface name="dirt_detector_right"/>
        <state_interface name="remote_opcode"/>
        <state_interface name="button_max"/>
        <state_interface name="button_clean"/>
        <state_interface name="button_spot"/>
        <state_interface name="button_power"/>
        <state_interface name="charging_state"/>  
        <state_interface name="voltage"/>
        <state_interface name="current"/>
        <state_interface name="temperature"/>
        <state_interface name="charge"/>
        <state_interface name="capacity"/>
      </sensor>

      <!-- Side brush -->
      <gpio name="${prefix}side_brush">
        <state_interface name="state"/>
        <command_interface name="state"/>
      </gpio>

      <!-- Vacuum -->
      <gpio name="${prefix}vacuum">
        <command_interface name="state"/>
        <state_interface name="state"/>
      </gpio>

      <!-- Main brush -->
      <gpio name="${prefix}motors">
        <command_interface name="state"/>
        <state_interface name="state"/>
      </gpio>
  
    </ros2_control>

    <xacro:if value="$(arg sim_gazebo_classic)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>${simulation_controllers}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg sim_gazebo)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${simulation_controllers}</parameters>
          <controller_manager_node_name>${prefix}controller_manager</controller_manager_node_name>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
